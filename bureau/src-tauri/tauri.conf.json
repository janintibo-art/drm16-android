{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DRM16",
  "version": "1.0.0",
  "identifier": "fr.tibo.drm16",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DRM16 · boîtes à rythmes",
        "width": 1180,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Boites a rythmes autonomes",
    "longDescription": "Vingt-cinq boites a rythmes et un rack Eurorack de quatre-vingt-neuf modules."
  }
}
