{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DRM16",
  "version": "145.0.0",
  "identifier": "fr.tibo.drm16",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DRM16 · boîtes à rythmes",
        "width": 1180,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Boites a rythmes et samplers autonomes",
    "longDescription": "Boites a rythmes, echantillonneurs, grooveboxes et rack Eurorack, hors ligne et sans compte. La meme application que la version Android."
  }
}
